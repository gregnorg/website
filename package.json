{
  "name": "turntable-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env.local scripts/run-tests.mjs",
    "test:browser": "node --env-file-if-exists=.env.local scripts/run-browser-tests.mjs",
    "migrate": "node scripts/apply-migration.js",
    "games:analysis:resume": "node --env-file-if-exists=.env.local scripts/resume-replay-analysis.ts",
    "games:analyze": "node --env-file-if-exists=.env.local scripts/process-replay-analysis.ts",
    "games:idle": "node --env-file-if-exists=.env.local scripts/process-idle-games.ts",
    "setup:push": "node scripts/ensure-vapid-keys.js"
  },
  "dependencies": {
    "better-auth": "latest",
    "next": "^16.3.1",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.20.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "typescript": "^5.9.3"
  }
}
