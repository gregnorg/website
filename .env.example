DATABASE_URL=postgresql://turntable:change-this-password@localhost:5432/turntable
# Local PostgreSQL does not need SSL. Set this to true only for a remote
# database service that requires it.
DATABASE_SSL=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The production hostname is allowlisted in lib/auth.ts. Cloudflare terminates
# HTTPS and forwards requests through the tunnel to the local HTTP server.
