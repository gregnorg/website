DATABASE_URL=postgresql://turntable:change-this-password@localhost:5432/turntable
# Local PostgreSQL does not need SSL. Set this to true only for a remote
# database service that requires it.
DATABASE_SSL=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Use your public site URL here when other devices will access the site.
# Examples: http://localhost:3000 or http://192.168.1.50:3000
BETTER_AUTH_URL=http://localhost:3000
