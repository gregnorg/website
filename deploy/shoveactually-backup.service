[Unit]
Description=Back up the Shove Actually PostgreSQL database
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=gregnorg
Group=gregnorg
EnvironmentFile=/home/gregnorg/website/.env.local
ExecStart=/home/gregnorg/website/scripts/backup-database.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/turntable
