[Unit]
Description=Shove Actually production web application
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=gregnorg
Group=gregnorg
WorkingDirectory=/home/gregnorg/website
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/home/gregnorg/website/.env.local
ExecStart=/home/gregnorg/.nvm/versions/node/v24.18.1/bin/node /home/gregnorg/website/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/gregnorg/website/.next

[Install]
WantedBy=multi-user.target
