[Unit]
Description=Monitor Shove Actually notification delivery
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@WEBSITE_DIR@@
Environment=NODE_ENV=production
EnvironmentFile=@@WEBSITE_DIR@@/.env.local
ExecStart=@@NODE_BIN@@ @@WEBSITE_DIR@@/scripts/check-push-health.ts
TimeoutStartSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
